# Rust 构建产物
/target
**/*.rs.bk

# .NET sidecar 构建产物（源码入库，bin/obj 不入）
sidecar-lhm/bin/
sidecar-lhm/obj/

# 发布目录（scripts/publish.ps1 生成）
/dist

# 本地数据（运行时生成，不入库）
*.log
appdata/

# IDE
.idea/
.vscode/
*.swp

# 系统
Thumbs.db
Desktop.ini
.DS_Store

# 冒烟测试输出
*-smoke.*

# 诊断产物
win-check.*
rel.out
rel.err
diag-*.out
diag-*.err

# crates/icons 仅 icon.ico（exe 资源嵌入）与 32x32.png（托盘嵌入）被源码引用；
# 其余为 Tauri/历史多尺寸图标产物（Square*/StoreLogo/@2x/icns 等），非源码不入库
/crates/icons/*.png
/crates/icons/*.icns
/crates/icons/*.ico
!/crates/icons/icon.ico
!/crates/icons/32x32.png
